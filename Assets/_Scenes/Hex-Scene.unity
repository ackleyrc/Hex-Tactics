  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 526cfc029ffd0ac41bacc01f0da7a79b, type: 3}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 200
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 0.85
  m_Text: "<size=70>Created and Developed by\nRobert Ackley</size>\n\n\n\nAll code
    was written by Robert Ackley.\nVisual and audio assets were sourced \nfrom various
    online marketplaces and repositories.\n\n\n\nArt sourced from the Unity Asset
    Store\n\nPainted 2D Terrain Hexes: Tropics and Wetlands by David Beumgart\n<size=36>https://assetstore.unity.com/packages/2d/environments/painted-2d-terrain-hexes-tropics-and-wetlands-107153</size>\n\nMedium
    Mech Striker by MSGDI\n<size=36>https://assetstore.unity.com/packages/3d/characters/robots/medium-mech-striker-124342</size>\n\n3D
    Lasers Pack by Hovl Studio\n<size=36>https://assetstore.unity.com/packages/vfx/particles/3d-lasers-pack-131685</size>\n\n3D
    Fire and Explosions by Hovl Studio\n<size=36>https://assetstore.unity.com/packages/vfx/particles/fire-explosions/3d-fire-and-explosions-176981</size>\n\n\n\nMusic
    sourced from Incompetech\n\nNeo Western by Kevin MacLeod\n<size=36>Link: https://incompetech.filmmusic.io/song/4114-neo-western\r\nLicense:
    http://creativecommons.org/licenses/by/4.0/</size>\n\nJet Fueled Vixen by Kevin
    MacLeod\n<size=36>Link: https://incompetech.filmmusic.io/song/3941-jet-fueled-vixen\r\nLicense:
    http://creativecommons.org/licenses/by/4.0/</size>\n\nI Can Feel it Coming by
    Kevin MacLeod\n<size=36>Link: https://incompetech.filmmusic.io/song/3893-i-can-feel-it-coming\r\nLicense:
    http://creativecommons.org/licenses/by/4.0/</size>\n\nMotherlode by Kevin MacLeod\n<size=36>Link:
    https://incompetech.filmmusic.io/song/4083-motherlode\r\nLicense: http://creativecommons.org/licenses/by/4.0/</size>\n\nTake
    The Lead by Kevin MacLeod\n<size=36>Link: https://incompetech.filmmusic.io/song/4458-take-the-lead\r\nLicense:
    http://creativecommons.org/licenses/by/4.0/</size>\n\nTwisted by Kevin MacLeod\n<size=36>Link:
    https://incompetech.filmmusic.io/song/4552-twisted\r\nLicense: http://creativecommons.org/licenses/by/4.0/</size>\n\nThe
    Whip by Kevin MacLeod\n<size=36>Link: https://incompetech.filmmusic.io/song/4515-the-whip\r\nLicense:
    http://creativecommons.org/licenses/by/4.0/</size>\n\nPump Sting by Kevin MacLeod\n<size=36>Link:
    https://incompetech.filmmusic.io/song/4251-pump-sting\r\nLicense: http://creativecommons.org/licenses/by/4.0/</size>\n\nHighlight
    Reel by Kevin MacLeod\n<size=36>Link: https://incompetech.filmmusic.io/song/3876-highlight-reel\r\nLicense:
    http://creativecommons.org/licenses/by/4.0/</size>\n\n\n\nSound Effects sourced
    from FreeSound\n\nDesert Ambient LOOP by Imjeax\n<size=36>Link: https://freesound.org/people/Imjeax/sounds/427401/\nLicense:
    http://creativecommons.org/licenses/by/3.0/</size>\n\nLaser by SamsterBirdies\n<size=36>Link:
    https://freesound.org/people/SamsterBirdies/sounds/470903/\nLicense: https://creativecommons.org/publicdomain/zero/1.0/</size>\n\nBeam
    by Deatlev\n<size=36>Link: https://freesound.org/people/Deatlev/sounds/254942/\nLicense:
    http://creativecommons.org/licenses/by/3.0/</size>\n\nwelding a piece of metal
    with sparks flying all over the place by Tomlijia\n<size=36>Link: https://freesound.org/people/Tomlija/sounds/103333/\nLicense:
    http://creativecommons.org/licenses/by/3.0/</size>\n\nWoodchipper Start (heavy
    machine) 02 by cmorris035\n<size=36>Link: https://freesound.org/people/cmorris035/sounds/319152/\nLicense:
    https://creativecommons.org/publicdomain/zero/1.0/</size>\n\nDoorcreak by chipfork71\n<size=36>Link:
    https://freesound.org/people/chipfork71/sounds/50857/\nLicense: http://creativecommons.org/licenses/by/3.0/</size>\n\nHeavy
    Door Creaking_03 by rambler 52\n<size=36>Link: https://freesound.org/people/rambler52/sounds/455320/\nLicense:
    https://creativecommons.org/publicdomain/zero/1.0/</size>\n\nMetal Door Groaning
    by Mafon2\n<size=36>Link: https://freesound.org/people/Mafon2/sounds/379803/\nLicense:
    http://creativecommons.org/licenses/by/3.0/</size>\n\nExploding Car (with Fire)
    (Mixed) by EFlexMusic\n<size=36>Link: https://freesound.org/people/EFlexMusic/sounds/396270/\nLicense:
    http://creativecommons.org/licenses/by-nc/3.0/</size>\n\nExplosion_001 by cydon\n<size=36>Link:
    https://freesound.org/people/cydon/sounds/268557/\nLicense: http://creativecommons.org/licenses/by-nc/3.0/</size>\n\nExplosion
    3 by harpoyume\n<size=36>Link: https://freesound.org/people/harpoyume/sounds/86026/\nLicense:
    http://creativecommons.org/licenses/by-nc/3.0/</size>\n\nExplosion 4 by harpoyume\n<size=36>Link:
    https://freesound.org/people/harpoyume/sounds/86032/\nLicense: http://creativecommons.org/licenses/by-nc/3.0/</size>\n\nExplosion
    (Pas) by studiomandragore\n<size=36>Link: https://freesound.org/people/studiomandragore/sounds/401628/\nLicense:
    https://creativecommons.org/publicdomain/zero/1.0/</size>\n\n_hh by bantha brain\n<size=36>Link:
    https://freesound.org/people/bantha%20brain/sounds/44384/\nLicense: https://creativecommons.org/licenses/sampling+/1.0/</size>\n\nclick
    a button by zepurple\n<size=36>Link: https://freesound.org/people/zepurple/sounds/540267/\nLicense:
    https://creativecommons.org/publicdomain/zero/1.0/</size>\n\nSqueakyClick1 by
    BMacZero\n<size=36>Link: https://freesound.org/people/BMacZero/sounds/94133/\nLicense:
    https://creativecommons.org/publicdomain/zero/1.0/</size>\n\nSingleWind2 by BMacZero\n<size=36>Link:
    https://freesound.org/people/BMacZero/sounds/96150/\nLicense: https://creativecommons.org/publicdomain/zero/1.0/</size>\n\nSnap
    Layered 03 by JoshuaPomeroy\n<size=36>Link: https://freesound.org/people/JoshuaPomeroy/sounds/532242/\nLicense:
    https://creativecommons.org/publicdomain/zero/1.0/</size>\n\nMorse 30 Wps by
    evelazquez\n<size=36>Link: https://freesound.org/people/evelazquez/sounds/329882/\nLicense:
    http://creativecommons.org/licenses/by-nc/3.0/</size>\n\n\n\n\nwith Gratitude
    for \nsome special sources of reseach and inspiration\n\nRed Blob Games | Amit
    Patel\n<size=36>https://www.redblobgames.com/</size>\n\nSebastian Lague\n<size=36>https://www.youtube.com/c/SebastianLague</size>\n\n\n\n\n\nwith
    Appreciation for\nthose providing testing, feedback, and suggestions\n\nAndrew
    Hung\nAndrew McPherson\nBrad Kraeling\nCamden Cecrle\nColin Vandervort\nEd Lu\nGreg
    Morton\nJacob Farny\nNotExplosive\nSteve Zapata\n\n\n\n\n\n\nwith Love for\nmy
    wonderful wife and her enduring support\n\nMaria Xu\n\n\n\n\n\n\n\n\n\nfinally...\n\n\n\n\n\n\n\n\n\nmy
    Thanks to\n\n<b>YOU</b>\n\n\n\n\n\n\n\n\n\n\n<size=80>Thanks for playing!</size>"
